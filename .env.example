# Jev / TypeSafe API（console.typesafe.ai 获取）
TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_BASE_URL=https://api.typesafe.ai

# 要盯的机型，逗号分隔，写得越具体（型号+容量）越准
TARGET_KEYWORDS=iPhone 15 Pro Max 256G,iPhone 16 Pro 256G

# 每个关键词抓多少条
MAX_RESULTS=30
# 捡漏条件：低于行情价至少这个比例，且至少这么多元
MIN_DISCOUNT_RATE=0.08
MIN_PROFIT=200
# Jev 可信度低于这个值不推送（0~1）
MIN_CONFIDENCE=0.5
# 行情价参考最近几天的数据
HISTORY_DAYS=3
SCAN_INTERVAL_MINUTES=15
# 无头模式（看不到浏览器窗口）；闲鱼可能拦截，建议先保持 false
HEADLESS=false

# 推送（可选）：飞书/钉钉/企微机器人 webhook
WEBHOOK_URL=
